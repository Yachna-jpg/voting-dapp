pragma language_version 0.23;

import CompactStandardLibrary;

export enum SessionState {
  ACTIVE,
  ENDED
}

export ledger owner: Bytes<32>;
export ledger status: SessionState;
export ledger totalVotes: Counter;
export ledger candidateVotes: Counter;

constructor() {
  status = SessionState.ACTIVE;
}

witness voterSecret(): Bytes<32>;
witness candidateId(): Bytes<32>;

export circuit castVote(): [] {
  assert(status == SessionState.ACTIVE, "Session is not active");
  
  const secret = voterSecret();
  const cId = candidateId();
  
  totalVotes.increment(1);
  candidateVotes.increment(1);
  owner = disclose(secret); 
}

export circuit endSession(): [] {
  status = SessionState.ENDED;
}
